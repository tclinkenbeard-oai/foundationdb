# This image is intentionally published once and consumed by digest from
# Dockerfile. Keep the component versions and checksums here so changing the
# build toolchain requires publishing a new base image.
FROM openaiapibase.azurecr.io/mirror/foundationdb/rockylinux9-latest@sha256:27e84fcd4a82e63b1f499cf199c84fe9a1831c8858947b3d9e0434b22317075a

ENV SCCACHE_VERSION=0.15.0 \
    SCCACHE_SHA256=782d2b5dd7ae0a55ebe368ab258114d0928d019ac2d949ab85d5d02f3926709e \
    CLANG_FORMAT_VERSION=19.1.5 \
    ZSTD_VERSION=1.5.7 \
    ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3

RUN curl -fsSL \
      "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      -o /tmp/sccache.tar.gz && \
    echo "${SCCACHE_SHA256}  /tmp/sccache.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/sccache.tar.gz --strip-components=1 -C /usr/local/bin && \
    rm -f /tmp/sccache.tar.gz && \
    sccache --version

# Keep formatting on the same pinned image as compilation so CI has one cold
# image pull instead of a second formatter-only image.
RUN python3 -m pip install \
        --no-cache-dir \
        --no-deps \
        --only-binary=:all: \
        "clang-format==${CLANG_FORMAT_VERSION}" && \
    clang-format --version | grep -F "${CLANG_FORMAT_VERSION}"

COPY building/docker/patches/zstd-1.5.7-fdb-001.patch /tmp/zstd-1.5.7-fdb-001.patch
RUN curl -fsSL \
      "https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz" \
      -o "/tmp/zstd-${ZSTD_VERSION}.tar.gz" && \
    echo "${ZSTD_SHA256}  /tmp/zstd-${ZSTD_VERSION}.tar.gz" | sha256sum -c - && \
    tar -xzf "/tmp/zstd-${ZSTD_VERSION}.tar.gz" -C /tmp && \
    cd "/tmp/zstd-${ZSTD_VERSION}" && \
    patch -p1 < "/tmp/zstd-${ZSTD_VERSION}-fdb-001.patch" && \
    make cmakebuild && \
    rm -rf "/tmp/zstd-${ZSTD_VERSION}" "/tmp/zstd-${ZSTD_VERSION}.tar.gz" "/tmp/zstd-${ZSTD_VERSION}-fdb-001.patch"
